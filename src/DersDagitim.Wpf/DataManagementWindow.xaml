<Window x:Class="DersDagitim.Wpf.DataManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Veri Yönetimi - Düzenlenebilir Katalog" Width="1200" Height="760" Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Kurum veri kataloğu" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="ASC XML ve yerel SQLite kayıtları burada izlenir; kaydettiğiniz değişiklikler kurum verisiyle birlikte saklanır." Foreground="#475569" Margin="0,6,0,18"/>
        <TabControl x:Name="EntityTabs" Grid.Row="2">
            <TabItem Header="Sınıflar / program türü">
                <DataGrid x:Name="ClassesGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sınıf" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Alan" Binding="{Binding Department}"/>
                        <DataGridTextColumn Header="Program türü" Binding="{Binding ProgramTypeText}"/>
                        <DataGridCheckBoxColumn Header="Geçici kayıt" Binding="{Binding IsDemo, Mode=OneWay}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Öğretmenler">
                <DataGrid x:Name="TeachersGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}"/>
                        <DataGridTextColumn Header="Kod" Binding="{Binding Code}"/>
                        <DataGridTextColumn Header="Haftalık üst sınır" Binding="{Binding WeeklyMaximumHours}"/>
                        <DataGridTextColumn Header="Kadro durumu" Binding="{Binding StaffStatus}"/>
                        <DataGridTextColumn Header="Renk" Binding="{Binding ColorCode}"/>
                        <DataGridTextColumn Header="Kaynak XML" Binding="{Binding SourceLabel}"/>
                        <DataGridCheckBoxColumn Header="Geçici kayıt" Binding="{Binding IsDemo, Mode=OneWay}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Dersler">
                <DataGrid x:Name="CoursesGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ders" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Kısaltma" Binding="{Binding Abbreviation}"/>
                        <DataGridTextColumn Header="Haftalık saat" Binding="{Binding WeeklyHours}"/>
                        <DataGridTextColumn Header="Blok seçenekleri" Binding="{Binding BlockOptionsText}"/>
                        <DataGridTextColumn Header="Kaynak XML" Binding="{Binding SourceText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Kaynaklar">
                <DataGrid x:Name="ResourcesGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kaynak" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Kapasite" Binding="{Binding Capacity}"/>
                        <DataGridTextColumn Header="Tür" Binding="{Binding Type}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Yeni" Click="New_Click" Padding="14,7" Margin="0,0,8,0"/>
            <Button Content="Düzenle" Click="Edit_Click" Padding="14,7" Margin="0,0,8,0"/>
            <Button Content="Sil" Click="Delete_Click" Padding="14,7" Margin="0,0,8,0"/>
            <Button Content="ASC XML içe aktar" Click="AscImport_Click" Padding="12,7" Margin="0,0,8,0"/>
            <Button Content="ASC XML dışa aktar" Click="AscExport_Click" Padding="12,7" Margin="0,0,8,0"/>
            <Button Content="Web listesini önizle" Click="WebPreview_Click" Padding="12,7" Margin="0,0,8,0"/>
            <Button Content="Web listesini aktar" Click="WebImport_Click" Padding="12,7" Margin="0,0,18,0"/>
            <Button Content="Öğretmen uygunluk ızgarası" Click="Availability_Click" Padding="12,7" Margin="0,0,8,0"/>
            <Button Content="Öğretmen rapor şablonu" Click="TeacherReport_Click" Padding="12,7" Margin="0,0,8,0"/>
            <Button Content="Program geçiş kuralları" Click="Transition_Click" Padding="12,7"/>
        </StackPanel>
    </Grid>
</Window>
