<Window x:Class="DersDagitim.Wpf.LaboratoryScheduleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sınıf ve Kaynak Haftalık Programları" Width="1240" Height="790" WindowState="Maximized" Background="#F8FAFC">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Sınıf ve Kaynak Haftalık Programları" FontSize="26" FontWeight="SemiBold"/>
    <DockPanel Grid.Row="1" Margin="0,14,0,10">
      <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="ModePicker" Width="150" Margin="0,0,8,0" SelectionChanged="ModePicker_SelectionChanged"/>
        <ComboBox x:Name="EntityPicker" Width="260" Margin="0,0,8,0" SelectionChanged="EntityPicker_SelectionChanged"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="CSV aktar" Click="ExportCsv_Click" Padding="12,7" Margin="0,0,8,0"/>
        <Button Content="PDF olarak kaydet" Click="ExportPdf_Click" Padding="12,7" Margin="0,0,8,0"/>
        <Button Content="aSc plan HTML" Click="ExportDoorLists_Click" Padding="12,7"/>
      </StackPanel>
    </DockPanel>

    <Border x:Name="ClassTeacherPanel" Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Sınıf öğretmeni" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="ClassTeacherCombo" Width="260" Height="30" Margin="0,0,8,0"/>
        <Button Content="Seçili sınıfa ata" Click="AssignClassTeacher_Click" Padding="12,6" Margin="0,0,8,0"/>
        <Button Content="Atamayı kaldır" Click="RemoveClassTeacher_Click" Padding="12,6" Margin="0,0,8,0"/>
        <Button Content="Şablon CSV" Click="ExportClassTeacherTemplate_Click" Padding="12,6" Margin="0,0,8,0"/>
        <Button Content="CSV'den toplu ata" Click="ImportClassTeachers_Click" Padding="12,6"/>
      </StackPanel>
    </Border>

    <DataGrid x:Name="ScheduleGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Gün" Binding="{Binding DayName}" Width="120"/>
        <DataGridTextColumn Header="Ders saati" Binding="{Binding LessonNumber}" Width="90"/>
        <DataGridTextColumn Header="Sınıf" Binding="{Binding ClassName}" Width="130"/>
        <DataGridTextColumn Header="Ders" Binding="{Binding CourseName}" Width="220"/>
        <DataGridTextColumn Header="Öğretmen" Binding="{Binding TeacherName}" Width="220"/>
        <DataGridTextColumn Header="Kaynak / Laboratuvar" Binding="{Binding ResourceName}" Width="220"/>
        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="140"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="#475569" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
