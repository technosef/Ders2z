<Window x:Class="DersDagitim.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ders Dağıtım Uygulaması" Width="1200" Height="760" WindowState="Maximized" Background="#F8FAFC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}">
            <StackPanel Margin="22">
                <TextBlock Text="DERS DAĞITIM" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,15,0,35"/>
                <TextBlock Text="İŞ AKIŞI" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,10"/>
                <Button Content="1 - Tanımlar" Click="Entity_Click" Style="{StaticResource NavButton}"/>
                <TextBlock Text="Öğretmen - Sınıf - Ders - Oda - Zaman" Foreground="#94A3B8" FontSize="10" TextWrapping="Wrap" Margin="10,0,0,10"/>
                <Button Content="2 - Kurallar ve Kilitler" Click="Settings_Click" Style="{StaticResource NavButton}"/>
                <Button Content="3 - Taslak Üret" Click="Draft_Click" Style="{StaticResource NavButton}"/>
                <Button Content="4 - Çakışma Kontrolü" Click="Conflict_Click" Style="{StaticResource NavButton}"/>
                <Button Content="5 - Çizelgeler" Click="Schedule_Click" Style="{StaticResource NavButton}"/>
                <Button Content="6 - Rapor - Excel / PDF" Click="Report_Click" Style="{StaticResource NavButton}"/>
                <Button Content="7 - Okul Genel Görünümü" Click="SchoolOverview_Click" Style="{StaticResource NavButton}"/>
                <Button Content="8 - Güncelleme / Hakkında" Click="AboutUpdate_Click" Style="{StaticResource NavButton}"/>
                <TextBlock Text="KURUM VERİSİ" Foreground="#FBBF24" FontSize="11" Margin="0,28,0,0"/>
                <TextBlock Text="ASC XML aktarımı, yerel SQLite kayıtları ve manuel kart değişiklikleri korunur." Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Ders programı çalışma alanı" FontSize="30" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="ASC kurum verisinden taslak üretin, manuel düzenlemeleri koruyun ve çıktıları doğrulayın." Foreground="#64748B" Margin="0,6,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Taslak Üret" Click="Draft_Click" Padding="18,10" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
            </DockPanel>
            <TextBlock x:Name="StatusText" Grid.Row="1" Text="Yerel SQLite deposu hazırlanıyor..." Foreground="#64748B" Margin="0,28,0,18"/>
            <ScrollViewer Grid.Row="2">
                <StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,0,24">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="SINIFLAR" Foreground="#64748B"/>
                                <TextBlock x:Name="ClassCount" Text="0" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ÖĞRETMENLER" Foreground="#64748B"/>
                                <TextBlock x:Name="TeacherCount" Text="0" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="DERSLER" Foreground="#64748B"/>
                                <TextBlock x:Name="CourseCount" Text="0" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Kurum programı çalışma alanı" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Tanımları ve kuralları gözden geçirin; ardından mevcut ASC kartlarını ve manuel değişiklikleri koruyan açıklanabilir bir taslak üretin. Çakışmaları kontrol edip sınıf, öğretmen, kaynak ve rapor görünümlerine geçin." TextWrapping="Wrap" Foreground="#475569" Margin="0,12,0,0"/>
                            <WrapPanel Margin="0,22,0,0">
                                <Button Content="Tanımları aç" Click="Entity_Click" Padding="14,8" Margin="0,0,10,0"/>
                                <Button Content="Okul genel görünümü" Click="SchoolOverview_Click" Padding="14,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
