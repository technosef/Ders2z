<Window x:Class="DersDagitim.Wpf.SchoolOverviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Okul Genel Gorunumu" Width="1250" Height="820" Background="#F8FAFC"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Okul Genel Gorunumu" FontSize="28" FontWeight="SemiBold"/><WrapPanel Grid.Row="1" Margin="0,16,0,12"><ComboBox Width="190" Margin="0,0,8,0" SelectedIndex="0"><ComboBoxItem>Alan: Tumu</ComboBoxItem><ComboBoxItem>Bilisim Teknolojileri</ComboBoxItem><ComboBoxItem>Elektrik-Elektronik</ComboBoxItem><ComboBoxItem>Biyomedikal</ComboBoxItem></ComboBox><ComboBox Width="190" Margin="0,0,8,0" SelectedIndex="0"><ComboBoxItem>Program: Tumu</ComboBoxItem><ComboBoxItem>Anadolu Meslek Programi</ComboBoxItem><ComboBoxItem>Anadolu Teknik Programi</ComboBoxItem></ComboBox><ComboBox Width="150" Margin="0,0,8,0" SelectedIndex="0"><ComboBoxItem>Sinif/Sube: Tumu</ComboBoxItem><ComboBoxItem>11/E</ComboBoxItem><ComboBoxItem>12/BM</ComboBoxItem></ComboBox><ComboBox Width="180" Margin="0,0,8,0" SelectedIndex="0"><ComboBoxItem>Ogretmen: Tumu</ComboBoxItem><ComboBoxItem>DEMO - Mehmet Akif Sonmez</ComboBoxItem></ComboBox><ComboBox Width="200" SelectedIndex="0"><ComboBoxItem>Kaynak: Tumu</ComboBoxItem><ComboBoxItem>Bilisim Laboratuvari 3</ComboBoxItem></ComboBox></WrapPanel><TextBlock Grid.Row="2" Text="Lejant: Yesil = bos slot / kullanilabilir; mavi = ders; turuncu = uyusmazlik veya kural ihlali; kirmizi = ders cakismasi. Renk tek basina anlam tasimaz, metin ve durum etiketi birlikte kullanilir." TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,14"/><DataGrid x:Name="OverviewGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Gun" Binding="{Binding Day}" Width="100"/><DataGridTextColumn Header="Sinif / Kaynak" Binding="{Binding Group}" Width="170"/><DataGridTextColumn Header="Ders saati" Binding="{Binding Slot}" Width="100"/><DataGridTextColumn Header="Alan" Binding="{Binding Department}" Width="180"/><DataGridTextColumn Header="Gorunum" Binding="{Binding Display}" Width="240"/><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="220"/></DataGrid.Columns></DataGrid></Grid></Window>
