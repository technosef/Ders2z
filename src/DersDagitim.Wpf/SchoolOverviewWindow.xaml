<Window x:Class="DersDagitim.Wpf.SchoolOverviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Okul Genel Görünümü" Width="1250" Height="820" WindowState="Maximized" Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Okul Genel Görünümü" FontSize="28" FontWeight="SemiBold"/>
        <WrapPanel Grid.Row="1" Margin="0,16,0,12">
            <ComboBox x:Name="DepartmentFilter" Width="190" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged"/>
            <ComboBox x:Name="ProgramFilter" Width="210" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged"/>
            <ComboBox x:Name="ClassFilter" Width="160" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged"/>
            <ComboBox x:Name="TeacherFilter" Width="210" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged"/>
            <ComboBox x:Name="ResourceFilter" Width="220" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged"/>
            <Button Content="Renkli okul dosyası" Click="ExportColored_Click" Padding="12,6"/>
        </WrapPanel>
        <TextBlock x:Name="SummaryText" Grid.Row="2" Text="Kurum ASC verisi yükleniyor..." TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,14"/>
        <DataGrid x:Name="OverviewGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Gün" Binding="{Binding Day}" Width="110"/>
                <DataGridTextColumn Header="Sınıf / Şube" Binding="{Binding Group}" Width="150"/>
                <DataGridTextColumn Header="Ders saati" Binding="{Binding Slot}" Width="100"/>
                <DataGridTextColumn Header="Alan" Binding="{Binding Department}" Width="180"/>
                <DataGridTextColumn Header="Görünüm" Binding="{Binding Display}" Width="*"/>
                <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
